      "name": "Validate input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body;\nconst lead = (b && typeof b === 'object') ? b : {};\nconst need = ['name', 'title', 'company', 'message'];\nconst missing = need.filter(k => typeof lead[k] !== 'string' || lead[k].trim() === '');\nreturn [{ json: { valid: missing.length === 0, missing, lead: Object.fromEntries(need.map(k => [k, String(lead[k] ?? '').slice(0, 2000)])) } }];"
      }
    },

    {
      "id": "n19213426",
      "name": "Parse model JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -60
      ],
      "parameters": {
        "jsCode": "const raw = String($input.first().json.text ?? '').trim().replace(/^```(?:json)?\\s*/i, '').replace(/```$/, '').trim();\nconst lead = $('Validate input').first().json.lead;\nlet out = { ok: false, lead, raw: raw.slice(0, 500) };\ntry {\n  const r = JSON.parse(raw);\n  const tiers = ['high', 'medium', 'low'];\n  if (tiers.includes(r.fit_tier) && typeof r.reason === 'string' && typeof r.suggested_next_step === 'string') {\n    out = { ok: true, lead, fit_tier: r.fit_tier, reason: r.reason, suggested_next_step: r.suggested_next_step };\n  }\n} catch (e) {}\nreturn [{ json: out }];"
      }
    },
    {

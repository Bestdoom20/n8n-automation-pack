      "name": "Shape result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -140
      ],
      "parameters": {
        "jsCode": "const j = $input.first().json;\nreturn [{ json: { lead: j.lead, fit_tier: j.fit_tier, reason: j.reason, suggested_next_step: j.suggested_next_step, model_output_valid: true } }];"
      }
    },
    {
      "id": "n20331603",
      "name": "Invalid JSON fallback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        40
      ],
      "parameters": {
        "jsCode": "const j = $input.first().json;\nreturn [{ json: { ok: false, lead: j.lead, fit_tier: 'unknown', reason: 'Model did not return valid JSON; flagged for manual review.', suggested_next_step: 'Review this lead by hand.', model_output_valid: false, raw_model_output: j.raw } }];"
      }
    },
    {
      "id": "n61383556",
      "name": "Build log line",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -60
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst line = { ts: new Date().toISOString(), ...r };\nconst b = await this.helpers.prepareBinaryData(Buffer.from(JSON.stringify(line) + '\\n'), 'lead-log.jsonl');\nreturn [{ json: r, binary: { data: b } }];"
      }
    },

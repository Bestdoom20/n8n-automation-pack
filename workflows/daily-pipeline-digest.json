    {
      "id": "n83353919",
      "name": "Aggregate counts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "const pipes = $('Get deal pipelines').first().json.results || [];\nconst label = {}; const order = [];\nfor (const p of pipes) for (const s of p.stages) { label[s.id] = p.label + ' / ' + s.label; order.push(label[s.id]); }\nconst counts = {}; let total = 0;\nfor (const page of $('Get deals').all()) for (const d of (page.json.results || [])) {\n  const k = label[d.properties?.dealstage] || 'unknown stage';\n  counts[k] = (counts[k] || 0) + 1; total++;\n}\nconst stages = [...order, 'unknown stage'].filter(k => counts[k]).map(k => ({ stage: k, deals: counts[k] }));\nconst date = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Vancouver' });\nconst prompt = 'Deal counts by pipeline stage as of ' + date + ' (total ' + total + '):\\n' + stages.map(s => s.stage + ': ' + s.deals).join('\\n') +\n  '\\nWrite exactly five short lines of plain-English insight for the owner: where most deals sit and its share of the total, what is thin, and one suggested focus. Do not just repeat the list. No preamble, no names.';\nreturn [{ json: { date, total, stages, prompt } }];"
      }
    },
    {
      "id": "n41266603",
      "name": "Write summary",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        960,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.prompt }}"
      }
    },
    {
      "id": "n54313242",
      "name": "Gemini (free) chat model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        960,
        180
      ],
      "parameters": {
        "modelName": "models/gemini-3.5-flash-lite",
        "options": {
          "temperature": 0.3
        }
      },
      "credentials": {
        "googlePalmApi": {
          "id": "gemcred0000000001",
          "name": "Gemini (free)"
        }
      }
    },
    {
      "id": "n68194846",
      "name": "Build markdown",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "const a = $('Aggregate counts').first().json;\nconst summary = String($input.first().json.text ?? '').trim();\nconst text = '# Pipeline digest ' + a.date + '\\n\\nTotal deals: ' + a.total + '\\n\\n| Stage | Deals |\\n| --- | --- |\\n' +\n  a.stages.map(s => '| ' + s.stage + ' | ' + s.deals + ' |').join('\\n') + '\\n\\n## Summary\\n\\n' + summary + '\\n';\nconst b = await this.helpers.prepareBinaryData(Buffer.from(text), 'digest.md');\nreturn [{ json: { file: 'pipeline-digest-' + a.date + '.md' }, binary: { data: b } }];"
      }
    },

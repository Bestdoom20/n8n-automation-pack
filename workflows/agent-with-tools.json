    {
      "id": "n75554400",
      "name": "get_weather",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        920,
        160
      ],
      "parameters": {
        "toolDescription": "Get current weather (temperature in C, wind speed) for a latitude and longitude from the open-meteo public API.",
        "method": "GET",
        "url": "https://api.open-meteo.com/v1/forecast",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "latitude",
              "value": "={{ $fromAI('latitude', 'Latitude in decimal degrees', 'number') }}"
            },
            {
              "name": "longitude",
              "value": "={{ $fromAI('longitude', 'Longitude in decimal degrees', 'number') }}"
            },
            {
              "name": "current",
              "value": "temperature_2m,wind_speed_10m"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n52392398",
      "name": "Shape answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        -60
      ],
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst steps = (j.intermediateSteps || []).map(s => ({ tool: s.action?.tool, input: s.action?.toolInput, observation: String(s.observation ?? '').slice(0, 300) }));\nreturn [{ json: { answer: j.output, tools_called: steps.map(s => s.tool), steps } }];"
      }
    },

        0
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body;\nconst q = b && typeof b.question === 'string' ? b.question.trim() : '';\nreturn [{ json: { valid: q.length > 0 && q.length <= 1000, question: q.slice(0, 1000) } }];"
      }
    },
